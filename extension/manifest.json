{
  "manifest_version": 3,
  "name": "FB Group Lead Scanner",
  "version": "0.1.0",
  "description": "Quét bài viết trong Facebook Groups theo tổ hợp từ khóa để tìm khách hàng tiềm năng.",
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://graph.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Lead Scanner"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/groups/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
